@code {
    private string? capturedImage;
    private string? uploadedPreview;
    private bool isDragging = false;
    private bool cameraError = false;
    private bool isAnalyzing = false;
    private bool isSaving = false;
    private string ocrLog = "";
    private Expense? scannedExpense;
    private List<Category> expenseCategories = new();
    private int step = 1;
    private int scanQuality = 0;
    private DotNetObjectReference<ScanReceipt>? objRef;

    public void Dispose()
    {
        objRef?.Dispose();
    }

    private List<(string Label, bool Done)> analyzeSteps = new()
    {
        ("Uploading image for processing", false),
        ("Running OCR text recognition", false),
        ("Extracting amounts and dates",  false),
        ("Detecting vendor name",         false),
        ("Parsing structured data",       false)
    };

    private string scanQualityLabel => scanQuality switch
    {
        >= 80 => "Excellent — all fields extracted",
        >= 60 => "Good — most fields found",
        >= 40 => "Fair — some fields may need editing",
        _ => "Low — manual correction recommended"
    };

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadFromStorageAsync();
        if (string.IsNullOrEmpty(Auth.UserId)) { Nav.NavigateTo("login"); return; }
        expenseCategories = (await Firebase.GetCategoriesAsync())
            .Where(c => c.Type == CategoryType.Expense).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && step == 1)
        {
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initDropZone", "receiptDropZone", objRef);

            try
            {
                await JS.InvokeVoidAsync("startCamera");
            }
            catch
            {
                cameraError = true;
                StateHasChanged();
            }
        }
    }

    [JSInvokable]
    public void HandleDroppedFile(string base64)
    {
        uploadedPreview = base64;
        StateHasChanged();
        ToastService.ShowToast("Image uploaded!", "success");
    }

    private async Task CapturePhoto()
    {
        try
        {
            capturedImage = await JS.InvokeAsync<string>("capturePhoto");
            uploadedPreview = null;
            step = 2;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Capture failed: {ex.Message}", "danger");
        }
    }

    private async Task HandleFileUpload(ChangeEventArgs e)
    {
        try
        {
            var base64 = await JS.InvokeAsync<string>("readFileAsBase64", "receiptFileInput");
            if (!string.IsNullOrEmpty(base64))
            {
                uploadedPreview = base64;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast("Could not read file: " + ex.Message, "danger");
        }
    }

    private void TriggerFileInput()
    {
        JS.InvokeVoidAsync("clickElement", "receiptFileInput");
    }

    private void ClearUpload()
    {
        uploadedPreview = null;
        StateHasChanged();
    }

    private async Task AnalyzeUploaded()
    {
        if (string.IsNullOrEmpty(uploadedPreview)) return;
        capturedImage = uploadedPreview;
        await RunOcrAnalysis();
    }

    private async Task AnalyzeCaptured()
    {
        await RunOcrAnalysis();
    }

    private async Task RunOcrAnalysis()
    {
        if (string.IsNullOrEmpty(capturedImage)) return;

        step = 2;
        isAnalyzing = true;
        StateHasChanged();

        // Animate the steps
        for (int i = 0; i < analyzeSteps.Count; i++)
        {
            await Task.Delay(600);
            analyzeSteps[i] = (analyzeSteps[i].Label, true);
            StateHasChanged();
        }

        try
        {
            var words = await OcrService.ExtractWordsFromImageAsync(capturedImage);
            var rawText = string.Join(" ", words.Select(w => w.Text));
            ocrLog = rawText;

            scannedExpense = OcrService.ParseExpenseFromWords(words, rawText);

            if (scannedExpense == null || scannedExpense.Amount == 0)
            {
                scannedExpense ??= new Expense { Title = "Receipt", Date = DateTime.Today, Amount = 0 };
                ToastService.ShowToast("Amount not detected. Please enter manually.", "warning");
                scanQuality = 30;
            }
            else
            {
                // Calculate quality based on what was found
                int q = 0;
                if (scannedExpense.Amount > 0) q += 40;
                if (!string.IsNullOrEmpty(rawText)) q += 20;
                if (scannedExpense.Date.Date != DateTime.Today) q += 20; // date was parsed
                if (scannedExpense.Title != "Receipt") q += 20; // vendor found
                scanQuality = Math.Min(100, q);
            }
        }
        catch (Exception ex)
        {
            ocrLog += "\n\nError: " + ex.Message;
            ToastService.ShowToast("OCR error: " + ex.Message, "danger");
            scannedExpense = new Expense { Title = "Receipt", Date = DateTime.Today, Amount = 0 };
            scanQuality = 0;
        }

        isAnalyzing = false;
        step = 3;
        StateHasChanged();
    }

    private void SyncCategory()
    {
        if (scannedExpense == null) return;
        var cat = expenseCategories.FirstOrDefault(c => c.Id == scannedExpense.CategoryId);
        if (cat != null) scannedExpense.Category = cat.Name ?? "";
    }

    private async Task SaveExpense()
    {
        if (scannedExpense == null) return;
        if (scannedExpense.Amount <= 0)
        {
            ToastService.ShowToast("Please enter a valid amount.", "warning");
            return;
        }

        isSaving = true;
        StateHasChanged();

        await Firebase.AddExpenseAsync(scannedExpense);
        ToastService.ShowToast("✅ Receipt saved to expenses!", "success");

        Nav.NavigateTo("expenses");
    }

    private async Task ResetAll()
    {
        step = 1;
        capturedImage = null;
        uploadedPreview = null;
        scannedExpense = null;
        ocrLog = "";
        cameraError = false;
        scanQuality = 0;
        isDragging = false;

        // Reset analyze steps
        analyzeSteps = analyzeSteps.Select(s => (s.Label, false)).ToList();

        StateHasChanged();

        try
        {
            await JS.InvokeVoidAsync("startCamera");
        }
        catch
        {
            cameraError = true;
            StateHasChanged();
        }
    }
}