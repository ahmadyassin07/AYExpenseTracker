@page "/budget"
@using AYExpenseTracker.Models
@using AYExpenseTracker.Services
@inject StateService State
@inject FirebaseAuthService Auth
@inject NavigationManager Nav
@inject ToastService ToastService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Budget & Goals | AYExpenseTracker</PageTitle>

<div class="page-content" dir="@(isArabic ? "rtl" : "ltr")">

    @if (State.IsLoading)
    {
        <div class="loading-overlay">
            <svg class="loading-progress">
                <defs>
                    <linearGradient id="progressGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#6366f1" />
                        <stop offset="100%" stop-color="#10b981" />
                    </linearGradient>
                </defs>
                <circle class="track" r="27" cx="30" cy="30" />
                <circle class="progress" r="27" cx="30" cy="30" />
            </svg>
            <div class="loading-text">Loading<span class="dots"></span></div>
        </div>
    }

    <div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="page-title">🎯 @(isArabic ? "الميزانية والأهداف" : "Budget & Goals")</h1>
            <p class="page-subtitle">@(isArabic ? "خطط للتوفير وتتبع أهدافك المالية" : "Plan savings and track your financial goals")</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" @onclick="ToggleLanguage">
                <i class="bi bi-translate"></i>
            </button>
        </div>
    </div>

    @* === TABS === *@
    <ul class="nav nav-tabs mb-4" style="display:flex !important">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "goals" ? "active" : "")" @onclick='() => activeTab = "goals"'>
                <i class="bi bi-trophy me-1"></i> @(isArabic ? "أهداف التوفير" : "Savings Goals")
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "budget" ? "active" : "")" @onclick='() => activeTab = "budget"'>
                <i class="bi bi-pie-chart me-1"></i> @(isArabic ? "ميزانية الفئات" : "Category Budget")
            </button>
        </li>
    </ul>

    @* ===== SAVINGS GOALS TAB ===== *@
    @if (activeTab == "goals")
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-light mb-0">@(isArabic ? "أهداف التوفير" : "Your Savings Goals")</h5>
            <button class="btn btn-primary btn-sm" @onclick="OpenAddGoal">
                <i class="bi bi-plus-lg"></i> @(isArabic ? "هدف جديد" : "New Goal")
            </button>
        </div>

        @if (!State.SavingsGoals.Any())
        {
            <div class="empty-state">
                <i class="bi bi-piggy-bank"></i>
                <h5>@(isArabic ? "لا توجد أهداف بعد" : "No goals yet")</h5>
                <p>@(isArabic ? "أضف هدفاً مالياً كشراء سيارة أو رحلة سفر" : "Add a financial goal like buying a car or planning a trip")</p>
                <button class="btn btn-primary mt-2" @onclick="OpenAddGoal">
                    <i class="bi bi-plus-lg"></i> @(isArabic ? "إضافة هدف" : "Add Goal")
                </button>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var goal in State.SavingsGoals)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="goal-card @(goal.IsCompleted ? "goal-completed" : "")">
                            @* Goal Header *@
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <div style="width:48px;height:48px;border-radius:var(--radius-md);background:@(goal.Color)22;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0">
                                    <i class="bi @goal.Icon" style="color:@goal.Color"></i>
                                </div>
                                <div class="flex-grow-1 min-width-0">
                                    <div class="fw-bold text-truncate">@goal.Title</div>
                                    @if (goal.IsCompleted)
                                    {
                                        <span class="badge" style="background:var(--accent-light);color:var(--accent);font-size:0.7rem">
                                            <i class="bi bi-check-circle me-1"></i>@(isArabic ? "مكتمل!" : "Completed!")
                                        </span>
                                    }
                                    else
                                    {
                                    <div style="font-size:0.75rem;color:var(--text-muted)">
                                        <i class="bi bi-clock-history me-1"></i> @goal.GetFormattedTimeRemaining(isArabic)
                                    </div>
                                }
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-secondary" @onclick="() => EditGoal(goal)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </div>
                        </div>

                        @* Progress Ring *@
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div style="position:relative;width:72px;height:72px;flex-shrink:0">
                                <svg width="72" height="72" style="transform:rotate(-90deg)">
                                    <circle cx="36" cy="36" r="30" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="5"/>
                                    <circle cx="36" cy="36" r="30" fill="none"
                                            stroke="@goal.Color"
                                            stroke-width="5"
                                            stroke-linecap="round"
                                            stroke-dasharray="188"
                                            stroke-dashoffset="@(188 - (188 * (double)goal.ProgressPercent / 100))"
                                            style="transition:stroke-dashoffset 0.8s ease;filter:drop-shadow(0 0 4px @(goal.Color)80)"/>
                                </svg>
                                <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:0.8rem;font-weight:700;color:var(--text-primary)">
                                    @goal.ProgressPercent.ToString("N0")%
                                </div>
                            </div>
                            <div>
                                <div style="font-size:1.15rem;font-weight:800;color:var(--text-primary);letter-spacing:-0.02em">
                                    @goal.CurrentAmount.ToString("N2") <span style="font-size:0.65rem;font-weight:500;opacity:0.6">KWD</span>
                                </div>
                                <div style="font-size:0.75rem;color:var(--text-muted)">
                                    @(isArabic ? "من أصل " : "out of ") <span class="fw-600 text-white-50">@goal.TargetAmount.ToString("N2")</span> KWD
                                </div>
                                <div style="font-size:0.75rem;color:var(--primary-light);margin-top:2px">
                                    @(isArabic ? "المطلوب:" : "Required:") <span class="fw-bold">@goal.RemainingAmount.ToString("N2")</span> KWD
                                </div>
                            </div>
                        </div>


                            @* Progress bar *@
                            <div class="budget-bar-container mb-2">
                                <div class="budget-bar @(goal.ProgressPercent >= 100 ? "budget-ok" : goal.ProgressPercent >= 50 ? "budget-warn" : "budget-over")"
                                     style="width:@(goal.ProgressPercent)%"></div>
                            </div>

                            @* Monthly savings needed *@
                            @if (!goal.IsCompleted)
                            {
                                <div style="background:var(--bg-glass);border-radius:var(--radius-sm);padding:0.5rem 0.75rem;font-size:0.8rem;margin-top:0.5rem">
                                    <i class="bi bi-calendar3 me-1" style="color:var(--primary)"></i>
                                    @(isArabic ? "وفّر شهرياً:" : "Save monthly:")
                                    <span class="fw-bold" style="color:var(--primary)"> @goal.MonthlySavingsRequired.ToString("N2") KWD</span>
                                </div>
                            }

                            @* Deposit Button *@
                            @if (!goal.IsCompleted)
                            {
                                var goalKey = goal.Id ?? "";
                                <div class="d-flex gap-2 mt-3">
                                    <input type="number" class="form-control form-control-sm" placeholder="@(isArabic ? "مبلغ إيداع..." : "Deposit amount...")"
                                           value="@GetDeposit(goalKey)"
                                           @oninput="e => SetDeposit(goalKey, e.Value?.ToString())" min="0.01" step="0.01" />
                                    <button class="btn btn-success btn-sm" @onclick="() => DepositToGoal(goal)">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>
                            }

                            <div class="d-flex justify-content-end mt-2">
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteGoal(goal.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @* ===== BUDGET BY CATEGORY TAB ===== *@
    @if (activeTab == "budget")
    {
        <div class="d-flex flex-column flex-md-row gap-3 mb-4">
            <div class="card flex-fill p-3">
                <div class="form-label">@(isArabic ? "دخلي الشهري (KWD)" : "Monthly Income (KWD)")</div>
                <input type="number" class="form-control" placeholder="@(isArabic ? "أدخل دخلك الشهري..." : "Enter monthly income...")"
                       @bind="monthlyIncome" @bind:event="oninput" min="0" step="0.001" />
            </div>
        </div>

        @if (!expenseCategories.Any())
        {
            <div class="empty-state">
                <i class="bi bi-tags"></i>
                <h5>@(isArabic ? "لا توجد فئات مصروفات" : "No expense categories")</h5>
                <p>@(isArabic ? "أضف فئات للمصروفات أولاً" : "Add expense categories first")</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var cat in expenseCategories)
                {
                    var spent = GetCategorySpend(cat.Id ?? "");
                    var budget = cat.BudgetLimit;
                    var pct = budget > 0 ? Math.Min(100m, spent / budget * 100m) : 0m;
                    var incomeRatio = monthlyIncome > 0 ? spent / monthlyIncome * 100m : 0m;

                    <div class="col-md-6">
                        <div class="card p-3">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div style="width:36px;height:36px;border-radius:var(--radius-sm);background:@(cat.Color)22;display:flex;align-items:center;justify-content:center">
                                    <i class="bi @cat.Icon" style="color:@cat.Color"></i>
                                </div>
                                <span class="fw-600">@cat.Name</span>
                                @if (incomeRatio > 20)
                                {
                                    <span class="badge ms-auto" style="background:var(--danger-light);color:var(--danger)">
                                        <i class="bi bi-exclamation-triangle me-1"></i>@incomeRatio.ToString("N0")% of income
                                    </span>
                                }
                            </div>

                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div style="font-size:0.8rem;color:var(--text-muted)">@(isArabic ? "الحد الشهري (KWD):" : "Monthly limit (KWD):")</div>
                                @{ var catKey = cat.Id ?? ""; }
                                <input type="number" class="form-control form-control-sm"
                                       value="@budget"
                                       @onchange="e => SetBudgetLimit(cat, e.Value?.ToString())"
                                       min="0" step="0.5"
                                       placeholder="Set limit..." />
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-1" style="font-size:0.8rem">
                                <span class="text-muted">@(isArabic ? "تم إنفاق" : "Spent"):</span>
                                <span class="fw-bold @(pct >= 100 ? "expense-amount" : pct >= 80 ? "" : "income-amount")">
                                    @spent.ToString("N2") KWD
                                    @if (budget > 0)
                                    {
                                        <span class="text-muted fw-normal"> / @budget.ToString("N2")</span>
                                    }
                                </span>
                            </div>

                            @if (budget > 0)
                            {
                                <div class="budget-bar-container">
                                    <div class="budget-bar @(pct >= 100 ? "budget-over" : pct >= 80 ? "budget-warn" : "budget-ok")"
                                         style="width:@(pct)%"></div>
                                </div>
                                @if (pct >= 100)
                                {
                                    <div style="font-size:0.75rem;color:var(--danger);margin-top:4px">
                                        <i class="bi bi-exclamation-triangle me-1"></i>@(isArabic ? "تجاوزت الميزانية!" : "Budget exceeded!")
                                    </div>
                                }
                                else if (pct >= 80)
                                {
                                    <div style="font-size:0.75rem;color:var(--warning);margin-top:4px">
                                        <i class="bi bi-exclamation-circle me-1"></i>@(isArabic ? "اقتربت من الحد!" : "Approaching limit!")
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            @* Summary *@
            @if (monthlyIncome > 0)
            {
                <div class="card mt-4 p-3">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-calculator me-2" style="color:var(--primary)"></i>
                        @(isArabic ? "ملخص الميزانية" : "Budget Summary")
                    </h6>
                    <div class="row g-3">
                        <div class="col-4 text-center">
                            <div style="font-size:1.2rem;font-weight:800;color:var(--accent)">@monthlyIncome.ToString("N2")</div>
                            <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em">@(isArabic ? "الدخل" : "Income") KWD</div>
                        </div>
                        <div class="col-4 text-center">
                            <div style="font-size:1.2rem;font-weight:800;color:var(--danger)">@totalMonthlySpend.ToString("N2")</div>
                            <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em">@(isArabic ? "المصاريف" : "Expenses") KWD</div>
                        </div>
                        <div class="col-4 text-center">
                            <div style="font-size:1.2rem;font-weight:800;color:@((monthlyIncome - totalMonthlySpend) >= 0 ? "var(--accent)" : "var(--danger)")">
                                @((monthlyIncome - totalMonthlySpend).ToString("N2"))
                            </div>
                            <div style="font-size:0.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em">@(isArabic ? "المتبقي" : "Remaining") KWD</div>
                        </div>
                    </div>
                    <div class="budget-bar-container mt-3" style="height:12px">
                        <div class="budget-bar @(totalMonthlySpend > monthlyIncome ? "budget-over" : totalMonthlySpend / monthlyIncome > 0.8m ? "budget-warn" : "budget-ok")"
                             style="width:@(Math.Min(100m, monthlyIncome > 0 ? totalMonthlySpend / monthlyIncome * 100m : 0m))%"></div>
                    </div>
                    <div style="font-size:0.75rem;color:var(--text-muted);margin-top:6px;text-align:right">
                        @(isArabic ? "نسبة الإنفاق:" : "Spending ratio:")
                        @(monthlyIncome > 0 ? (totalMonthlySpend / monthlyIncome * 100m).ToString("N1") : "0")%
                    </div>
                </div>
            }
        }
    }
</div>

@* === ADD/EDIT GOAL MODAL === *@
@if (editingGoal != null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.75)" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content animate-scale-in" style="background: var(--bg-surface); color: var(--text-primary);">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-trophy me-2" style="color:var(--warning)"></i>
                        @(string.IsNullOrEmpty(editingGoal.Id) ? (isArabic ? "إضافة هدف جديد" : "New Savings Goal") : (isArabic ? "تعديل الهدف" : "Edit Goal"))
                    </h5>
                    <button class="btn btn-sm btn-secondary" @onclick="() => editingGoal = null">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@(isArabic ? "اسم الهدف" : "Goal Name") *</label>
                        <input type="text" class="form-control" @bind="editingGoal.Title"
                               placeholder="@(isArabic ? "مثال: شراء سيارة" : "e.g. Buy a car")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@(isArabic ? "الوصف" : "Description")</label>
                        <textarea class="form-control" @bind="editingGoal.Description" rows="2"
                                  placeholder="@(isArabic ? "وصف اختياري..." : "Optional...")"></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label">@(isArabic ? "المبلغ المستهدف (KWD)" : "Target Amount (KWD)") *</label>
                            <input type="number" class="form-control" @bind="editingGoal.TargetAmount" min="1" step="0.5" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">@(isArabic ? "المبلغ المدخر حتى الآن" : "Current Saved")</label>
                            <input type="number" class="form-control" @bind="editingGoal.CurrentAmount" min="0" step="0.5" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@(isArabic ? "تاريخ الهدف" : "Target Date")</label>
                        <InputDate class="form-control" @bind-Value="editingGoal.TargetDate" />
                    </div>

                    @* Icon picker *@
                    <div class="mb-3">
                        <label class="form-label">@(isArabic ? "الأيقونة" : "Icon")</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var icon in goalIcons)
                            {
                                <button type="button"
                                        class="btn btn-sm @(editingGoal.Icon == icon ? "btn-primary" : "btn-secondary")"
                                        style="width:40px;height:40px;padding:0"
                                        @onclick="() => editingGoal.Icon = icon">
                                    <i class="bi @icon"></i>
                                </button>
                            }
                        </div>
                    </div>

                    @* Color picker *@
                    <div class="mb-4">
                        <label class="form-label">@(isArabic ? "اللون" : "Color")</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var color in goalColors)
                            {
                                <div class="color-swatch @(editingGoal.Color == color ? "selected" : "")"
                                     style="background:@color"
                                     @onclick="() => editingGoal.Color = color"></div>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <button class="btn btn-secondary" @onclick="() => editingGoal = null">@(isArabic ? "إلغاء" : "Cancel")</button>
                        <button class="btn btn-primary" @onclick="SaveGoal">
                            <i class="bi bi-check-circle me-1"></i>
                            @(string.IsNullOrEmpty(editingGoal.Id) ? (isArabic ? "إضافة" : "Add Goal") : (isArabic ? "تحديث" : "Update"))
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* === DELETE CONFIRMATION MODAL === *@
@if (showDeleteConfirm)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.75)" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content animate-scale-in border-0 shadow-lg" style="background: var(--bg-surface); color: var(--text-primary);">
                <div class="modal-header bg-danger text-white border-0">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @(isArabic ? "تأكيد الحذف" : "Confirm Deletion")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body py-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-trash3 text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <p class="fs-5 mb-0">@(isArabic ? "هل أنت متأكد من حذف هذا الهدف؟" : "Are you sure you want to delete this goal?")</p>
                    <p class="text-muted small"> @(isArabic ? "سيتم حذف جميع سجلات هذا الهدف نهائياً." : "This will permanently remove the goal and its progress.")</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary px-4" @onclick="CancelDelete">@(isArabic ? "إلغاء" : "Cancel")</button>
                    <button type="button" class="btn btn-danger px-4" @onclick="ConfirmDelete">
                        <i class="bi bi-trash me-1"></i> @(isArabic ? "حذف نهائياً" : "Delete Permanently")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isArabic = false;
    private string activeTab = "goals";
    private decimal monthlyIncome = 0m;
    private bool showDeleteConfirm = false;
    private string? goalToDeleteId;

    private SavingsGoal? editingGoal;

    private Dictionary<string, decimal> depositAmounts = new();

    private List<Category> expenseCategories => State.Categories.Where(c => c.Type == CategoryType.Expense).ToList();
    private decimal totalMonthlySpend => State.Expenses.Where(e => e.Type == TransactionType.Expense && e.Date.Month == DateTime.Today.Month && e.Date.Year == DateTime.Today.Year).Sum(e => e.Amount);

    private readonly List<string> goalIcons = new()
    {
        "bi-car-front", "bi-house-door", "bi-airplane", "bi-phone", "bi-laptop",
        "bi-piggy-bank", "bi-briefcase", "bi-mortarboard", "bi-heart", "bi-gem",
        "bi-bicycle", "bi-camera", "bi-music-note", "bi-trophy", "bi-star"
    };

    private readonly List<string> goalColors = new()
    {
        "#6366f1", "#10b981", "#f59e0b", "#ef4444", "#3b82f6",
        "#8b5cf6", "#ec4899", "#14b8a6", "#f97316", "#84cc16"
    };

    protected override async Task OnInitializedAsync()
    {
        var savedLang = await JS.InvokeAsync<string>("localStorage.getItem", "lang");
        isArabic = savedLang == "ar";

        await Auth.LoadFromStorageAsync();
        if (string.IsNullOrEmpty(Auth.UserId)) { Nav.NavigateTo("login"); return; }

        State.OnChange += StateHasChanged;
        
        if (!State.Expenses.Any() || !State.SavingsGoals.Any())
        {
            await State.InitializeAsync();
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private void ToggleLanguage()
    {
        isArabic = !isArabic;
        JS.InvokeVoidAsync("localStorage.setItem", "lang", isArabic ? "ar" : "en");
    }

    private decimal GetCategorySpend(string catId) =>
        State.Expenses.Where(e => e.CategoryId == catId && e.Type == TransactionType.Expense &&
                       e.Date.Month == DateTime.Today.Month && e.Date.Year == DateTime.Today.Year)
               .Sum(e => e.Amount);

    private async Task SetBudgetLimit(Category cat, string? val)
    {
        if (cat != null && decimal.TryParse(val, out var d))
        {
            cat.BudgetLimit = d;
            await State.UpdateCategoryAsync(cat);
            ToastService.ShowToast(isArabic ? $"تم تحديث ميزانية {cat.Name}" : $"Budget for {cat.Name} updated", "success");
        }
    }

    private decimal GetDeposit(string key)
        => depositAmounts.TryGetValue(key, out var v) ? v : 0m;

    private void SetDeposit(string key, string? val)
    {
        if (!string.IsNullOrEmpty(key) && decimal.TryParse(val, out var d))
            depositAmounts[key] = d;
    }

    private void OpenAddGoal()
    {
        editingGoal = new SavingsGoal
        {
            TargetDate = DateTime.Today.AddYears(1),
            Icon = "bi-piggy-bank",
            Color = "#6366f1"
        };
    }

    private void EditGoal(SavingsGoal goal)
    {
        editingGoal = new SavingsGoal
        {
            Id = goal.Id, Title = goal.Title, Description = goal.Description,
            TargetAmount = goal.TargetAmount, CurrentAmount = goal.CurrentAmount,
            TargetDate = goal.TargetDate, Icon = goal.Icon, Color = goal.Color,
            CreatedAt = goal.CreatedAt
        };
    }

    private async Task SaveGoal()
    {
        if (editingGoal == null || string.IsNullOrWhiteSpace(editingGoal.Title)) return;

        if (string.IsNullOrEmpty(editingGoal.Id))
        {
            await State.AddSavingsGoalAsync(editingGoal);
            ToastService.ShowToast(isArabic ? "✅ تم إضافة الهدف" : "✅ Goal added!", "success");
        }
        else
        {
            await State.UpdateSavingsGoalAsync(editingGoal);
            ToastService.ShowToast(isArabic ? "✅ تم التحديث" : "✅ Goal updated!", "success");
        }

        editingGoal = null;
    }

    private void DeleteGoal(string? id)
    {
        if (string.IsNullOrEmpty(id)) return;
        goalToDeleteId = id;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (string.IsNullOrEmpty(goalToDeleteId)) return;
        await State.DeleteSavingsGoalAsync(goalToDeleteId);
        ToastService.ShowToast(isArabic ? "🗑 تم الحذف" : "🗑 Goal deleted", "success");
        showDeleteConfirm = false;
        goalToDeleteId = null;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        goalToDeleteId = null;
    }

    private async Task DepositToGoal(SavingsGoal goal)
    {
        var amount = depositAmounts.ContainsKey(goal.Id ?? "") ? depositAmounts[goal.Id ?? ""] : 0m;
        if (amount <= 0) { ToastService.ShowToast(isArabic ? "أدخل مبلغاً صحيحاً" : "Enter a valid amount", "warning"); return; }

        goal.CurrentAmount = Math.Min(goal.TargetAmount, goal.CurrentAmount + amount);
        await State.UpdateSavingsGoalAsync(goal);

        depositAmounts[goal.Id ?? ""] = 0m;
        ToastService.ShowToast(isArabic ? $"✅ تم إضافة {amount:N2} KWD" : $"✅ Deposited {amount:N2} KWD", "success");
    }
}
