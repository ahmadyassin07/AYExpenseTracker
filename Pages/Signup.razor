@page "/signup"
@using AYExpenseTracker.Models
@using AYExpenseTracker.Services
@inject FirebaseAuthService Auth
@inject NavigationManager Nav
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>Sign Up | AYExpenseTracker</PageTitle>

<div dir="@(isArabic ? "rtl" : "ltr")" class="auth-premium-wrapper">

    <!-- Language Toggle -->
    <div class="p-4 position-absolute top-0 end-0 z-100">
        <button class="btn-premium-sm" @onclick="ToggleLanguage">
            <i class="bi bi-translate me-2"></i> @(isArabic ? "English" : "العربية")
        </button>
    </div>

    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="auth-card-container animate-scale-in">
            <div class="glass-card auth-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="auth-icon-wrapper mb-3 mx-auto animate-float">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h2 class="auth-title mb-2">@(isArabic ? "إنشاء حساب" : "Create Account")</h2>
                    <p class="auth-subtitle">@(isArabic ? "ابدأ رحلتك لمراقبة مصاريفك بذكاء" : "Start your journey to track expenses smarter")</p>
                </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-danger py-2 text-center">@message</div>
        }

                <EditForm Model="@credentials" OnValidSubmit="SignupUser">
                    <DataAnnotationsValidator />
                    
                    <div class="form-group-premium mb-4">
                        <label class="form-label-premium">@(isArabic ? "البريد الإلكتروني" : "Email Address")</label>
                        <div class="input-premium-wrapper">
                            <i class="bi bi-envelope"></i>
                            <InputText class="input-premium" @bind-Value="credentials.Email" 
                                       placeholder="name@example.com" />
                        </div>
                        <ValidationMessage For="@(() => credentials.Email)" class="validation-error-premium" />
                    </div>

                    <div class="form-group-premium mb-4">
                        <label class="form-label-premium">@(isArabic ? "كلمة المرور" : "Password")</label>
                        <div class="input-premium-wrapper">
                            <i class="bi bi-lock"></i>
                            <InputText type="password" class="input-premium" 
                                       @bind-Value="credentials.Password" 
                                       placeholder="••••••••" />
                        </div>
                        <ValidationMessage For="@(() => credentials.Password)" class="validation-error-premium" />
                    </div>

                    <button type="submit" class="btn-auth-primary w-100 mb-4 mt-2">
                        <span>@(isArabic ? "إنشاء حساب" : "Create Account")</span>
                        <i class="bi bi-person-plus ms-2"></i>
                    </button>

                    <div class="text-center">
                        <p class="auth-footer-text">
                            @(isArabic ? "لديك حساب بالفعل؟" : "Already have an account?")
                            <a href="login" class="auth-link fw-bold">@(isArabic ? "تسجيل الدخول" : "Sign In")</a>
                        </p>
                    </div>
                </EditForm>
            </div>
            
            <div class="auth-brand-footer text-center mt-4">
                <div class="text-white-50 small">&copy; @DateTime.Now.Year AYExpenseTracker</div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Verify Email -->
<!-- Modal: Verify Email -->
@if (showVerifyModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(3, 7, 18, 0.8); backdrop-filter: blur(8px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card border-0">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title h4">
                        @(isArabic ? "تحقق من بريدك الإلكتروني" : "Verify Your Email")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseVerifyModal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="auth-icon-wrapper mb-4 mx-auto animate-float" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i class="bi bi-envelope-check"></i>
                    </div>
                    <p class="text-white mb-4">
                        @(isArabic
                            ? $"شكراً لتسجيلك! 🎉 يرجى التحقق من بريدك الإلكتروني {credentials.Email} والنقر على رابط التفعيل لتتمكن من تسجيل الدخول."
                            : $"Thank you for signing up! 🎉 Please check your email {credentials.Email} and click the verification link to activate your account before logging in.")
                    </p>
                    <button class="btn-auth-primary w-100" @onclick="CloseVerifyModal">
                        @(isArabic ? "موافق" : "Got it")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .auth-premium-wrapper {
        min-height: 100vh;
        background: #030712;
        background: radial-gradient(circle at top right, rgba(99, 102, 241, 0.15), transparent),
                    radial-gradient(circle at bottom left, rgba(16, 185, 129, 0.1), transparent);
        color: #f8fafc;
        font-family: 'Inter', sans-serif;
        position: relative;
        overflow-x: hidden;
    }

    .auth-card-container {
        width: 100%;
        max-width: 480px;
    }

    .auth-card {
        border-radius: 2rem !important;
        background: rgba(17, 24, 39, 0.7) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
    }

    .auth-icon-wrapper {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(16, 185, 129, 0.2));
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1.25rem;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.75rem; color: #6366f1;
    }

    .auth-title {
        font-weight: 800; letter-spacing: -0.04em;
        background: linear-gradient(135deg, #fff 0%, #94a3b8 100%);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .auth-subtitle { color: #94a3b8; font-size: 0.95rem; }

    .form-group-premium { position: relative; }
    .form-label-premium { font-size: 0.85rem; font-weight: 600; color: #cbd5e1; margin-bottom: 0.5rem; display: block; }
    .input-premium-wrapper { position: relative; display: flex; align-items: center; }
    .input-premium-wrapper i { position: absolute; left: 1.25rem; color: #64748b; font-size: 1.1rem; }
    [dir="rtl"] .input-premium-wrapper i { left: auto; right: 1.25rem; }

    .input-premium {
        width: 100%; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1rem; padding: 0.875rem 1.25rem 0.875rem 3.25rem; color: white; font-size: 0.95rem; transition: all 0.2s ease;
    }
    [dir="rtl"] .input-premium { padding: 0.875rem 3.25rem 0.875rem 1.25rem; }
    .input-premium:focus { background: rgba(255, 255, 255, 0.05); border-color: #6366f1; outline: none; box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15); }

    .btn-auth-primary {
        background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border: none; padding: 1rem; border-radius: 1rem;
        font-weight: 700; display: flex; align-items: center; justify-content: center; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .btn-auth-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3); }

    .btn-premium-sm {
        background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: white;
        padding: 0.5rem 1rem; border-radius: 0.75rem; font-size: 0.85rem; font-weight: 600; transition: all 0.2s ease;
    }
    .btn-premium-sm:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.2); }

    .auth-footer-text { color: #94a3b8; font-size: 0.9rem; }
    .auth-link { color: #6366f1; text-decoration: none; transition: color 0.2s ease; }
    .auth-link:hover { color: #818cf8; }

    .validation-error-premium { color: #ef4444; font-size: 0.75rem; margin-top: 0.25rem; list-style: none; padding: 0; }

    .animate-float { animation: auth-float 6s ease-in-out infinite; }
    @@keyframes auth-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    .animate-scale-in { animation: auth-scaleIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @@keyframes auth-scaleIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }

    .glass-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }
</style>

@code {
    private UserCredentials credentials = new();
    private string message = string.Empty;
    private bool showVerifyModal = false;
    private bool isArabic = false;

    protected override async Task OnInitializedAsync()
    {
        var savedLang = await JS.InvokeAsync<string>("localStorage.getItem", "lang");
        isArabic = savedLang == "ar";
    }

    private void ToggleLanguage()
    {
        isArabic = !isArabic;
        JS.InvokeVoidAsync("localStorage.setItem", "lang", isArabic ? "ar" : "en");
        StateHasChanged();
    }

    private async Task SignupUser()
    {
        message = string.Empty;

        var (success, errorCode) = await Auth.SignUpAsync(credentials.Email, credentials.Password);

        if (success)
        {
            showVerifyModal = true;
            credentials = new UserCredentials();
        }
        else
        {
            if (errorCode == "EMAIL_EXISTS")
            {
                message = isArabic
                    ? "لديك حساب بالفعل. حاول إعادة تعيين كلمة المرور."
                    : "You already have an account. Try resetting your password.";
            }
            else
            {
                message = isArabic
                    ? $"فشل إنشاء الحساب: {errorCode}"
                    : $"Signup failed: {errorCode}";
            }

            ToastService.ShowToast(message, "warning");
        }
    }

    private void CloseVerifyModal()
    {
        showVerifyModal = false;
        credentials = new UserCredentials();
    }
}
