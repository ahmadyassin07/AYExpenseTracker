    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        StateHasChanged();

        // Load language preference
        var savedLang = await JS.InvokeAsync<string>("localStorage.getItem", "lang");
        isArabic = savedLang == "ar";

        // Load auth from storage
        await Auth.LoadFromStorageAsync();

        if (!string.IsNullOrEmpty(Auth.IdToken))
        {
            // Returning user with valid token → go to expenses
            bool refreshed = await Auth.RefreshIdTokenAsync();
            if (refreshed)
            {
                Nav.NavigateTo("expenses");
                return;
            }
            else
            {
                // Token expired → optionally show toast, clear storage, go to login
                ToastService.ShowToast(isArabic ? "انتهت صلاحية الجلسة. يرجى تسجيل الدخول مرة أخرى." : "Session expired. Please log in again.", "danger");
                await JS.InvokeVoidAsync("localStorage.clear");
                await JS.InvokeVoidAsync("sessionStorage.clear");
                Nav.NavigateTo("login");
                return;
            }
        }

        // New user → stay on Home page
        isLoading = false;
        StateHasChanged();
    }
    
    
    
    
    
    
    
    private async Task LogoutAndRedirect()
    {
        await JS.InvokeVoidAsync("localStorage.clear");
        await JS.InvokeVoidAsync("sessionStorage.clear");

        isLoading = false;
        StateHasChanged();

        await Task.Delay(200);
        Nav.NavigateTo("login");
    }


    private void ToggleLanguage()
    {
        isArabic = !isArabic;
        JS.InvokeVoidAsync("localStorage.setItem", "lang", isArabic ? "ar" : "en");
        StateHasChanged();
    }

    private void GoLogin() => Nav.NavigateTo("login");
    private void GoSignup() => Nav.NavigateTo("signup");
}
