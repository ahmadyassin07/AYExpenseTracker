    private async Task RenderCharts(IEnumerable<dynamic> grouped)
    {
        try
        {
            if (!grouped.Any())
            {
                await JS.InvokeVoidAsync("clearChart", "categoryPie");
                await JS.InvokeVoidAsync("clearChart", "monthlyTrend");
                await JS.InvokeVoidAsync("clearChart", "dailyTrend");
                return;
            }

            // 🔹 Category pie chart
            var labels = grouped.Select(g => g.Key).ToArray();
            var data = grouped.Select(g => (decimal)g.Total).ToArray();
            await JS.InvokeVoidAsync("renderPieChart", "categoryPie", labels, data);

            // 🔹 Daily trend for current month
            var firstDay = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
            var lastDay = firstDay.AddMonths(1).AddDays(-1);

            var daily = expenses
                .Where(e => e.Date >= firstDay && e.Date <= lastDay)
                .GroupBy(e => e.Date.Day)
                .Select(g => new { Day = g.Key, Total = g.Sum(x => x.Amount) })
                .OrderBy(g => g.Day)
                .ToList();

            // Fill missing days with zero (for a smooth line chart)
            var fullDaily = Enumerable.Range(1, (lastDay - firstDay).Days + 1)
                .Select(day => new
                {
                    Day = day,
                    Total = daily.FirstOrDefault(d => d.Day == day)?.Total ?? 0m
                })
                .ToList();

            await JS.InvokeVoidAsync("renderLineChart", "dailyTrend",
                fullDaily.Select(d => d.Day.ToString()),
                fullDaily.Select(d => d.Total));

            // 🔹 Monthly trend (all months available)
            var monthly = expenses
                .GroupBy(e => new { e.Date.Year, e.Date.Month })
                .Select(g => new
                {
                    Label = $"{g.Key.Month:D2}/{g.Key.Year}",
                    Total = g.Sum(x => x.Amount)
                })
                .OrderBy(g => g.Label)
                .ToList();

            await JS.InvokeVoidAsync("renderLineChart", "monthlyTrend",
                monthly.Select(x => x.Label),
                monthly.Select(x => x.Total));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"RenderCharts error: {ex.Message}");
        }
    }








    private async Task ExportAsPDF() => await JS.InvokeVoidAsync("exportInsightsPDF");
