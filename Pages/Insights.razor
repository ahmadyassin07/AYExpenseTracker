    private void UpdateInsights(List<Expense>? filtered = null)
    {
        var data = filtered ?? expenses;

        // 🔹 Filter data based on selected period (e.g., last X months)
        if (_selectedPeriod > 0 && filtered == null)
        {
            // 🔹 Calculate the start and end dates based on the selected period
            var startMonth = DateTime.Now.AddMonths(-_selectedPeriod + 1); // include current month
            var since = new DateTime(startMonth.Year, startMonth.Month, 1); // first day of that month

            // 🔹 End date: today (or last day of current month if you prefer full month)
            var end = DateTime.Today;

           

            data = data.Where(e => e.Date.Date >= since && e.Date.Date <= end).ToList();
        }

        // 🔹 Total spent
        totalSpent = data.Sum(e => e.Amount);

        // 🔹 Group by category
        grouped = data.GroupBy(e => e.Category)
            .Select(g => new { Key = g.Key, Total = g.Sum(x => x.Amount) })
            .OrderByDescending(g => g.Total)
            .ToList();

        topCategory = grouped.FirstOrDefault()?.Key ?? "-";
        selectedCategory = topCategory;
        selectedCategoryTotal = grouped.FirstOrDefault()?.Total ?? 0m;

        // 🔹 Potential savings (10% of top 3 categories)
        potentialSavings = grouped.Take(3).Sum(x => (decimal)x.Total * 0.1m);

        // 🔹 Average monthly spend
        var monthsCount = data
            .Select(e => new { e.Date.Year, e.Date.Month })
            .Distinct()
            .Count();

        avgMonthlySpend = monthsCount > 0 ? totalSpent / monthsCount : 0m;

        // 🔹 Compare current vs last month
        var thisMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        var lastMonth = thisMonth.AddMonths(-1);

        lastMonthTotal = data
            .Where(e => e.Date.Year == lastMonth.Year && e.Date.Month == lastMonth.Month)
            .Sum(e => e.Amount);

        currentMonthTotal = data
            .Where(e => e.Date.Year == thisMonth.Year && e.Date.Month == thisMonth.Month)
            .Sum(e => e.Amount);

        // 🔹 Insight message
        if (currentMonthTotal > lastMonthTotal)
        {
            monthOverMonthMessage = isArabic ? "⚠ المصاريف زادت!" : "⚠ Spending increased!";
            monthOverMonthClass = "text-danger";
        }
        else if (currentMonthTotal < lastMonthTotal)
        {
            monthOverMonthMessage = isArabic ? "✅ وفرت هذا الشهر!" : "✅ You saved this month!";
            monthOverMonthClass = "text-success";
        }
        else
        {
            monthOverMonthMessage = isArabic ? "لا تغيير عن الشهر الماضي." : "No change from last month.";
            monthOverMonthClass = "text-warning";
        }

        // 🔹 Forecast next month
        forecastNextMonth = avgMonthlySpend;

        // 🔹 Generate insights and charts
        GenerateInsightsAndSuggestions(grouped);
        _ = InvokeAsync(() => RenderCharts(grouped));
    }









    private void SelectCategory(string category) => selectedCategory = category;

    private void GenerateInsightsAndSuggestions(IEnumerable<dynamic> grouped)
    {
        insights.Clear();
        if (!grouped.Any()) return;
        var top = grouped.First();
        insights.Add(isArabic ? $"أعلى فئة إنفاق لديك هي {top.Key} ({((decimal)top.Total):N2} KWD)." : $"Your highest spending category is {top.Key} ({((decimal)top.Total):N2} KWD).");
        if (monthlyIncome > 0)
        {
            decimal ratio = totalSpent / monthlyIncome * 100;
            if (ratio > 50) insights.Add(isArabic ? "⚠ إنفاقك أكثر من نصف دخلك!" : "⚠ You are spending more than half of your income!");
            else if (ratio > 30) insights.Add(isArabic ? "💡 مصاريفك معتدلة، حاول التوفير 10–15% من دخلك." : "💡 Moderate spending, try saving 10–15% of your income.");
            else insights.Add(isArabic ? "✅ لديك تحكم ممتاز بالمصاريف!" : "✅ Excellent! You have good control over your spending.");
        }

        foreach (var cat in grouped.Take(3))
        {
            decimal percOfIncome = monthlyIncome > 0 ? (decimal)cat.Total / monthlyIncome * 100 : 0;
            if (percOfIncome > 20)
                insights.Add(isArabic ? $"💡 {cat.Key} تشكل {percOfIncome:N1}% من دخلك. قللها لتوفير أكثر." : $"💡 {cat.Key} is {percOfIncome:N1}% of your income. Reduce it to save more.");
        }
    }

