@page "/insights"
@using AYExpenseTracker.Models
@using AYExpenseTracker.Services
@inject FirebaseService Firebase
@inject FirebaseAuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(isArabic ? "تحليلات المصاريف الذكية" : "Smart Expense Insights | AYExpenseTracker")</PageTitle>

<div dir="@(isArabic ? "rtl" : "ltr")" class="insights-container py-4 text-light">

    <!-- Language Toggle -->
    <div class="d-flex justify-content-end w-100 p-3">
        <button class="btn btn-outline-light btn-sm language-toggle" @onclick="ToggleLanguage">
            @(isArabic ? "English" : "العربية")
        </button>
    </div>

    <!-- Date Filters -->
    <div class="card shadow-lg mb-3 glass-card">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4 col-12">
                    <label class="form-label fw-bold">@((isArabic ? "من تاريخ" : "From Date"))</label>
                    <InputDate class="form-control" @bind-Value="fromDate" />
                </div>
                <div class="col-md-4 col-12">
                    <label class="form-label fw-bold">@((isArabic ? "إلى تاريخ" : "To Date"))</label>
                    <InputDate class="form-control" @bind-Value="toDate" />
                </div>
                <div class="col-md-4 col-12 d-flex flex-wrap gap-2">
                    <button class="btn btn-primary flex-fill flex-sm-auto" @onclick="LoadExpensesDate">
                        <i class="bi bi-search me-1"></i> @(isArabic ? "بحث" : "Search")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Header & period selection -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-warning">💡 @(isArabic ? "تحليلات ذكية وتوفير" : "Smart Insights & Savings")</h2>
        <div style="width:220px">
            <select class="form-select form-select-sm" @bind="SelectedPeriod">
                <option value="1">@((isArabic ? "هذا الشهر" : "This Month"))</option>
                <option value="3">@((isArabic ? "آخر 3 أشهر" : "Last 3 Months"))</option>
                <option value="6">@((isArabic ? "آخر 6 أشهر" : "Last 6 Months"))</option>
                <option value="12">@((isArabic ? "آخر 12 شهر" : "Last 12 Months"))</option>
            </select>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card glass-card text-center p-3">
                <h6>@((isArabic ? "إجمالي المصاريف" : "Total Spent"))</h6>
                <h3 class="text-info fw-bold">@totalSpent.ToString("N2") KWD</h3>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card glass-card text-center p-3">
                <h6>@((isArabic ? "أعلى فئة" : "Top Category"))</h6>
                <h4 class="text-warning fw-bold">@topCategory</h4>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card glass-card text-center p-3">
                <h6>@((isArabic ? "التوفير المحتمل" : "Potential Savings"))</h6>
                <h3 class="text-success fw-bold">@potentialSavings.ToString("N2") KWD</h3>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card glass-card text-center p-3">
                <h6>@((isArabic ? "متوسط الإنفاق الشهري" : "Avg Monthly Spend"))</h6>
                <h3 class="text-primary fw-bold">@avgMonthlySpend.ToString("N2") KWD</h3>
            </div>
        </div>
    </div>

    <!-- Income Input & Forecast -->
    <div class="card glass-card p-4 mb-4">
        <h5>💵 @(isArabic ? "الدخل الشهري" : "Monthly Income")</h5>
        <input type="number" class="form-control mb-2" placeholder="@(isArabic ? "أدخل راتبك بالكويت دينار" : "Enter your salary in KWD")" min="0"
               @bind-value="monthlyIncome" @bind-value:event="oninput" />
        @if (monthlyIncome > 0)
        {
            <p>
                @(isArabic ? "يمكنك التوفير المحتمل:" : "Potential Savings:")
                <b>@Math.Max(monthlyIncome - totalSpent, 0).ToString("N2") KWD</b> @(isArabic ? "هذا الشهر" : "this month")
            </p>
            <p class="@((totalSpent > monthlyIncome) ? "text-danger" : "text-success") fw-bold">
                @(totalSpent > monthlyIncome
                            ? (isArabic ? "⚠ إنفاقك أعلى من دخلك! قلل المصاريف غير الضرورية." : "⚠ Spending exceeds income! Reduce unnecessary expenses.")
                            : (isArabic ? "✅ لديك فرصة للتوفير." : "✅ You are on track to save."))
        </p>
        <p class="fw-bold text-info">
            @(isArabic ? $"💡 توقع الشهر القادم: {forecastNextMonth:N2} KWD" : $"💡 Forecast for next month: {forecastNextMonth:N2} KWD")
        </p>
                }
    </div>

    <!-- Charts -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card glass-card p-3">
                <h5>@(isArabic ? "توزيع الفئات" : "Category Distribution")</h5>
                <canvas id="categoryPie"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card glass-card p-3">
                <h5>@(isArabic ? "الإنفاق اليومي" : "Daily Spending")</h5>
                <canvas id="dailyTrend"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card glass-card p-3">
                <h5>@(isArabic ? "اتجاه الإنفاق الشهري" : "Monthly Spending Trend")</h5>
                <canvas id="monthlyTrend"></canvas>
            </div>
        </div>
    </div>

    <!-- Month-over-Month -->
    <div class="card glass-card p-3 mb-4">
        <h5>📊 @(isArabic ? "مقارنة الشهر السابق" : "Month-over-Month")</h5>
        <p>@(isArabic ? "الشهر السابق:" : "Last month:") <b>@lastMonthTotal.ToString("N2") KWD</b></p>
        <p>@(isArabic ? "الشهر الحالي:" : "This month:") <b>@currentMonthTotal.ToString("N2") KWD</b></p>
        <p class="@monthOverMonthClass fw-bold">@monthOverMonthMessage</p>
    </div>

    <!-- Category Breakdown & Actionable Tips -->
    <div class="card glass-card p-4 mb-4">
        <h5>📂 @(isArabic ? "تفاصيل الفئات ونصائح للتوفير" : "Category Breakdown & Tips")</h5>
        @if (!grouped.Any())
        {
            <p class="text-muted">@((isArabic ? "لا توجد فئات للعرض." : "No categories to show."))</p>
        }
        else
        {
            @foreach (var cat in grouped)
            {
                decimal percTotal = totalSpent > 0 ? (decimal)cat.Total / totalSpent * 100 : 0;
                decimal percIncome = monthlyIncome > 0 ? (decimal)cat.Total / monthlyIncome * 100 : 0;
                <div class="mb-2">
                    <span class="fw-bold" @onclick="() => SelectCategory(cat.Key)" style="cursor:pointer;">@cat.Key</span>
                    <div class="progress mt-1">
                        <div class="progress-bar @(percIncome > 20 ? "bg-danger" : "bg-warning")" role="progressbar" style="width:@percTotal%">
                            @percTotal.ToString("N1")%
                        </div>
                    </div>
                    @if (percIncome > 20)
                    {
                        <small class="text-warning">
                            @(isArabic ? $"⚠ تشكل هذه الفئة أكثر من 20% من دخلك، حاول تقليلها." : $"⚠ This category is over 20% of your income. Consider reducing it.")
                        </small>
                    }
                </div>
            }
        }
    </div>

    <!-- What-if Simulation -->
    <div class="card glass-card p-4 mb-4">
        <h5>💰 @(isArabic ? "ماذا لو قللت من" : "What if you reduced your") <span class="text-warning">@selectedCategory</span> @(isArabic ? "الإنفاق؟" : "spending?")</h5>
        <input type="range" min="0" max="50" step="5" @bind="reductionPercent" class="form-range" />
        <p>@(isArabic ? "خفض بنسبة:" : "Reduce by:") <b>@reductionPercent%</b></p>
        <p class="text-success fw-bold">
            @(isArabic ? "يمكنك التوفير:" : "You could save:") @((selectedCategoryTotal * (reductionPercent / 100m)).ToString("N2")) KWD/@(isArabic ? "الشهر" : "month")
        </p>
    </div>

    <!-- Smart Insights -->
    <div class="card glass-card p-4 mb-4">
        <h5>📈 @(isArabic ? "تحليلات ذكية" : "Smart Insights")</h5>
        <ul>
            @foreach (var insight in insights)
            {
                <li>@insight</li>
            }
        </ul>
    </div>

    <!-- Export -->
    <div class="text-end mb-5">
        <button class="btn btn-warning" @onclick="ExportAsPDF">📝 @(isArabic ? "تصدير التحليلات" : "Export Insights as PDF")</button>
    </div>

</div>

<style>
    .insights-container {
        background: linear-gradient(180deg, #041a2f, #000814);
        min-height: 100vh;
    }

    .glass-card {
        background: rgba(255,255,255,0.08);
        border: none;
        backdrop-filter: blur(6px);
        border-radius: 1rem;
        color: #fff;
        transition: all 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        }

    .progress {
        height: 20px;
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar {
        text-align: center;
        font-weight: 600;
        color: #000;
    }

    .language-toggle {
        backdrop-filter: blur(4px);
        background-color: rgba(255,255,255,0.12);
        border-color: rgba(255,255,255,0.3);
        color: #fff;
        font-weight: 600;
    }

        .language-toggle:hover {
            transform: scale(1.03);
        }
</style>

