@page "/categories"
@using AYExpenseTracker.Models
@using AYExpenseTracker.Services
@inject StateService State
@inject FirebaseAuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService ToastService
@implements IDisposable

<PageTitle>Categories | AYExpenseTracker</PageTitle>

<div class="page-content" dir="@(isArabic ? "rtl" : "ltr")">

    @if (State.IsLoading)
    {
        <div class="loading-overlay">
            <svg class="loading-progress">
                <defs>
                    <linearGradient id="progressGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#6366f1" />
                        <stop offset="100%" stop-color="#10b981" />
                    </linearGradient>
                </defs>
                <circle class="track" r="27" cx="30" cy="30" />
                <circle class="progress" r="27" cx="30" cy="30" />
            </svg>
            <div class="loading-text">Loading<span class="dots"></span></div>
        </div>
    }

    <div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="page-title">🏷️ @(isArabic ? "الفئات" : "Categories")</h1>
            <p class="page-subtitle">@(isArabic ? "إدارة فئات المصروفات والدخل" : "Manage expense and income categories")</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light btn-sm" @onclick="ToggleLanguage">
                <i class="bi bi-translate"></i>
            </button>
            <button class="btn btn-primary" @onclick="OpenAddModal">
                <i class="bi bi-plus-lg"></i> @(isArabic ? "إضافة فئة" : "Add Category")
            </button>
        </div>
    </div>

    @* Stats *@
    <div class="row g-3 mb-4">
        <div class="col-4">
            <div class="stat-card text-center">
                <div class="stat-value">@State.Categories.Count</div>
                <div class="stat-label mt-1">@(isArabic ? "إجمالي الفئات" : "Total")</div>
            </div>
        </div>
        <div class="col-4">
            <div class="stat-card text-center">
                <div class="stat-value" style="color:var(--danger)">@State.Categories.Count(c => c.Type == CategoryType.Expense)</div>
                <div class="stat-label mt-1">@(isArabic ? "مصروفات" : "Expenses")</div>
            </div>
        </div>
        <div class="col-4">
            <div class="stat-card text-center">
                <div class="stat-value" style="color:var(--accent)">@State.Categories.Count(c => c.Type == CategoryType.Income)</div>
                <div class="stat-label mt-1">@(isArabic ? "دخل" : "Income")</div>
            </div>
        </div>
    </div>

    @* Tabs *@
    <div class="type-selector mb-3">
        <button class="type-btn @(activeTab == "all" ? "active-expense" : "")" @onclick='() => activeTab = "all"'>
            @(isArabic ? "الكل" : "All")
        </button>
        <button class="type-btn @(activeTab == "expense" ? "active-expense" : "")" @onclick='() => activeTab = "expense"'>
            <i class="bi bi-arrow-down-circle me-1"></i> @(isArabic ? "مصروفات" : "Expenses")
        </button>
        <button class="type-btn @(activeTab == "income" ? "active-income" : "")" @onclick='() => activeTab = "income"'>
            <i class="bi bi-arrow-up-circle me-1"></i> @(isArabic ? "دخل" : "Income")
        </button>
    </div>

    @* Category Grid *@
    @{
        var displayed = activeTab switch
        {
            "expense" => State.Categories.Where(c => c.Type == CategoryType.Expense).ToList(),
            "income" => State.Categories.Where(c => c.Type == CategoryType.Income).ToList(),
            _ => State.Categories.ToList()
        };
    }

    @if (!displayed.Any())
    {
        <div class="empty-state">
            <i class="bi bi-tags"></i>
            <h5>@(isArabic ? "لا توجد فئات" : "No categories yet")</h5>
            <p>@(isArabic ? "أضف فئتك الأولى للبدء" : "Add your first category to get started")</p>
            <button class="btn btn-primary mt-2" @onclick="OpenAddModal">
                <i class="bi bi-plus-lg"></i> @(isArabic ? "إضافة فئة" : "Add Category")
            </button>
        </div>
    }
    else
    {
        @* Desktop Table *@
        <div class="card d-none d-md-block">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>@(isArabic ? "الفئة" : "Category")</th>
                            <th>@(isArabic ? "النوع" : "Type")</th>
                            <th>@(isArabic ? "الوصف" : "Description")</th>
                            <th class="text-end">@(isArabic ? "إجراءات" : "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in displayed)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:36px;height:36px;border-radius:var(--radius-md);background:@(cat.Color)22;display:flex;align-items:center;justify-content:center;">
                                            <i class="bi @cat.Icon" style="color:@cat.Color;font-size:1rem"></i>
                                        </div>
                                        <span class="fw-600">@cat.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge" style="background:@(cat.Type == CategoryType.Income ? "var(--accent-light)" : "var(--danger-light)");color:@(cat.Type == CategoryType.Income ? "var(--accent)" : "var(--danger)")">
                                        <i class="bi @(cat.Type == CategoryType.Income ? "bi-arrow-up" : "bi-arrow-down") me-1"></i>
                                        @cat.Type
                                    </span>
                                </td>
                                <td class="text-muted" style="font-size:0.85rem">@cat.Description</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-secondary me-1" @onclick="() => EditCategory(cat)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteCategory(cat.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Mobile Cards *@
        <div class="d-md-none row g-2">
            @foreach (var cat in displayed)
            {
                bool isExp = expandedCategoryId == cat.Id;
                <div class="col-12">
                    <div class="transaction-card" @onclick="() => ToggleExpand(cat.Id)">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:44px;height:44px;border-radius:var(--radius-md);background:@(cat.Color)22;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                <i class="bi @cat.Icon" style="color:@cat.Color;font-size:1.2rem"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-600">@cat.Name</div>
                                <span class="badge" style="background:@(cat.Type == CategoryType.Income ? "var(--accent-light)" : "var(--danger-light)");color:@(cat.Type == CategoryType.Income ? "var(--accent)" : "var(--danger)");font-size:0.7rem">
                                    @cat.Type
                                </span>
                            </div>
                            <i class="bi @(isExp ? "bi-chevron-up" : "bi-chevron-down")" style="color:var(--text-muted)"></i>
                        </div>
                        @if (isExp)
                        {
                            <div class="mt-3 pt-2 animate-slide-up" style="border-top:1px solid var(--border)">
                                @if (!string.IsNullOrWhiteSpace(cat.Description))
                                {
                                    <p class="text-muted small mb-2">@cat.Description</p>
                                }
                                <div class="d-flex gap-2 justify-content-end">
                                    <button class="btn btn-sm btn-secondary" @onclick:stopPropagation="true" @onclick="() => EditCategory(cat)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick:stopPropagation="true" @onclick="() => DeleteCategory(cat.Id)">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@* === ADD/EDIT MODAL === *@
@if (editingCategory != null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.75)" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content animate-scale-in" style="background: var(--bg-surface); color: var(--text-primary);">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(string.IsNullOrEmpty(editingCategory.Id) ? "bi-plus-circle" : "bi-pencil-square") me-2" style="color:var(--primary)"></i>
                        @(string.IsNullOrEmpty(editingCategory.Id)
                            ? (isArabic ? "إضافة فئة" : "Add Category")
                            : (isArabic ? "تعديل الفئة" : "Edit Category"))
                    </h5>
                    <button class="btn btn-sm btn-secondary" @onclick="CloseEdit"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@editingCategory" OnValidSubmit="@SaveCategory">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        @* Type Toggle *@
                        <div class="mb-3">
                            <label class="form-label">@(isArabic ? "نوع الفئة" : "Category Type")</label>
                            <div class="type-selector">
                                <button type="button" class="type-btn @(editingCategory.Type == CategoryType.Expense ? "active-expense" : "")"
                                        @onclick="() => editingCategory.Type = CategoryType.Expense">
                                    <i class="bi bi-arrow-down-circle me-1"></i> @(isArabic ? "مصروف" : "Expense")
                                </button>
                                <button type="button" class="type-btn @(editingCategory.Type == CategoryType.Income ? "active-income" : "")"
                                        @onclick="() => editingCategory.Type = CategoryType.Income">
                                    <i class="bi bi-arrow-up-circle me-1"></i> @(isArabic ? "دخل" : "Income")
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@(isArabic ? "اسم الفئة" : "Category Name") *</label>
                            <InputText class="form-control" @bind-Value="editingCategory.Name"
                                       placeholder="@(isArabic ? "مثال: بقالة" : "e.g. Groceries")" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@(isArabic ? "الوصف" : "Description")</label>
                            <InputTextArea class="form-control" @bind-Value="editingCategory.Description"
                                           placeholder="@(isArabic ? "وصف اختياري..." : "Optional description...")" rows="2" />
                        </div>

                        @* Icon Picker *@
                        <div class="mb-3">
                            <label class="form-label">@(isArabic ? "الأيقونة" : "Icon")</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var icon in availableIcons)
                                {
                                    <button type="button"
                                            class="btn btn-sm @(editingCategory.Icon == icon ? "btn-primary" : "btn-secondary")"
                                            style="width:40px;height:40px;padding:0"
                                            @onclick="() => editingCategory.Icon = icon"
                                            title="@icon">
                                        <i class="bi @icon"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        @* Color Picker *@
                        <div class="mb-4">
                            <label class="form-label">@(isArabic ? "اللون" : "Color")</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var color in availableColors)
                                {
                                    <div class="color-swatch @(editingCategory.Color == color ? "selected" : "")"
                                         style="background:@color"
                                         @onclick="() => editingCategory.Color = color"
                                         title="@color"></div>
                                }
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-secondary" @onclick="CloseEdit">@(isArabic ? "إلغاء" : "Cancel")</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>
                                @(string.IsNullOrEmpty(editingCategory.Id) ? (isArabic ? "إضافة" : "Add") : (isArabic ? "تحديث" : "Update"))
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@* === DELETE CONFIRMATION MODAL === *@
@if (showDeleteConfirm)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.75)" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content animate-scale-in border-0 shadow-lg" style="background: var(--bg-surface); color: var(--text-primary);">
                <div class="modal-header bg-danger text-white border-0">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @(isArabic ? "تأكيد الحذف" : "Confirm Deletion")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body py-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-trash3 text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <p class="fs-5 mb-0">@(isArabic ? "هل أنت متأكد من حذف هذه الفئة؟" : "Are you sure you want to delete this category?")</p>
                    <p class="text-muted small"> @(isArabic ? "سيتم حذف الفئة نهائياً. لا يمكن حذف الفئات المستخدمة في المعاملات." : "This will permanently remove the category. Categories with existing transactions cannot be deleted.")</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary px-4" @onclick="CancelDelete">@(isArabic ? "إلغاء" : "Cancel")</button>
                    <button type="button" class="btn btn-danger px-4" @onclick="ConfirmDelete">
                        <i class="bi bi-trash me-1"></i> @(isArabic ? "حذف نهائياً" : "Delete Permanently")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isArabic = false;
    private string activeTab = "all";
    private string? expandedCategoryId;
    private bool showDeleteConfirm = false;
    private string? categoryToDeleteId;

    private Category? editingCategory;

    private readonly List<string> availableIcons = new()
    {
        "bi-tag", "bi-cart3", "bi-house-door", "bi-car-front", "bi-lightning-charge",
        "bi-phone", "bi-hospital", "bi-book", "bi-airplane", "bi-cup-hot",
        "bi-bag", "bi-gamepad", "bi-music-note", "bi-person-circle", "bi-briefcase",
        "bi-cash-coin", "bi-bank", "bi-piggy-bank", "bi-gift", "bi-heart"
    };

    private readonly List<string> availableColors = new()
    {
        "#6366f1", "#10b981", "#f59e0b", "#ef4444", "#3b82f6",
        "#8b5cf6", "#ec4899", "#14b8a6", "#f97316", "#84cc16",
        "#06b6d4", "#a78bfa", "#fb923c", "#34d399", "#60a5fa"
    };

    protected override async Task OnInitializedAsync()
    {
        var savedLang = await JS.InvokeAsync<string>("localStorage.getItem", "lang");
        isArabic = savedLang == "ar";

        await Auth.LoadFromStorageAsync();
        if (string.IsNullOrEmpty(Auth.UserId)) { Nav.NavigateTo("login"); return; }
        
        State.OnChange += StateHasChanged;

        if (!State.Categories.Any())
        {
            await State.InitializeAsync();
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private void ToggleLanguage()
    {
        isArabic = !isArabic;
        JS.InvokeVoidAsync("localStorage.setItem", "lang", isArabic ? "ar" : "en");
    }

    private void OpenAddModal() => editingCategory = new Category();

    private void EditCategory(Category cat)
    {
        editingCategory = new Category
        {
            Id = cat.Id, Name = cat.Name, Description = cat.Description,
            Type = cat.Type, Icon = cat.Icon, Color = cat.Color
        };
    }

    private void CloseEdit() => editingCategory = null;

    private void ToggleExpand(string? id) => expandedCategoryId = expandedCategoryId == id ? null : id;

    private async Task SaveCategory()
    {
        if (editingCategory == null) return;

        if (string.IsNullOrEmpty(editingCategory.Id))
        {
            await State.AddCategoryAsync(editingCategory);
            ToastService.ShowToast(isArabic ? "✅ تم إضافة الفئة" : "✅ Category added", "success");
        }
        else
        {
            await State.UpdateCategoryAsync(editingCategory);
            ToastService.ShowToast(isArabic ? "✅ تم التحديث" : "✅ Updated", "success");
        }

        CloseEdit();
    }

    private void DeleteCategory(string? id)
    {
        if (string.IsNullOrEmpty(id)) return;
        categoryToDeleteId = id;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (string.IsNullOrEmpty(categoryToDeleteId)) return;

        bool success = await State.DeleteCategoryAsync(categoryToDeleteId);
        if (success)
        {
            ToastService.ShowToast(isArabic ? "🗑 تم الحذف" : "🗑 Deleted", "success");
        }
        
        showDeleteConfirm = false;
        categoryToDeleteId = null;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        categoryToDeleteId = null;
    }
}
