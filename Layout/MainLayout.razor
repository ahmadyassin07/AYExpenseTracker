        color: var(--text-primary);
        font-size: 0.875rem;
        transition: var(--transition);
    }

    .search-input-wrapper input:focus {
        outline: none;
        border-color: var(--primary);
        background: var(--bg-surface);
        box-shadow: 0 0 0 3px var(--primary-light);
    }

    /* ===== FAB ===== */
    .fab-btn {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: linear-gradient(135deg, var(--primary), #8b5cf6);
        border: none;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px var(--primary-glow);
        z-index: 1050;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: pointer;
        padding: 0;
        overflow: hidden;
    }

    .fab-btn i {
        font-size: 1.5rem;
        transition: transform 0.3s ease;
    }

    .fab-btn:hover {
        transform: scale(1.1) translateY(-5px);
        box-shadow: 0 8px 25px var(--primary-glow);
        width: 154px;
    }

    .fab-btn:hover i {
        transform: rotate(90deg);
        margin-right: 8px;
    }

    .fab-label {
        width: 0;
        opacity: 0;
        white-space: nowrap;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .fab-btn:hover .fab-label {
        width: auto;
        opacity: 1;
    }

    @@media (max-width: 767px) {
        .fab-btn {
            bottom: calc(var(--mobile-nav-height) + 1.25rem) !important;
            right: 1.25rem !important;
            top: auto !important; /* Force bottom placement */
        }
        
        /* On mobile, keep it circular or slightly smaller */
        .fab-btn:hover {
            width: 56px;
        }
        .fab-btn:hover .fab-label {
            display: none;
        }
        .fab-btn:hover i {
            margin-right: 0;
        }
    }
    /* ===== PWA BANNERS ===== */
    .pwa-update-banner {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 2000;
        background: linear-gradient(90deg, var(--primary), var(--accent));
        padding: 0.625rem 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        color: white;
        font-size: 0.85rem;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        animation: slideInDown 0.4s ease;
    }

    .pwa-update-banner i { font-size: 1rem; }
    
    .btn-refresh {
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        font-size: 0.75rem;
        cursor: pointer;
        transition: 0.2s;
        display: flex; align-items: center; gap: 0.4rem;
    }
    .btn-refresh:hover { background: rgba(255,255,255,0.3); }

    .pwa-install-banner {
        position: fixed;
        bottom: calc(var(--mobile-nav-height) + 1rem);
        left: 1rem; right: 1rem;
        z-index: 1050;
        animation: slideInUp 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@media (min-width: 768px) {
        .pwa-install-banner {
            width: 360px;
            left: auto; right: 2rem;
            bottom: 2rem;
        }
    }

    .install-card {
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--border);
        border-radius: 1.25rem;
        padding: 1.25rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.5);
        position: relative;
    }

    .close-banner {
        position: absolute; top: 0.75rem; right: 0.75rem;
        background: transparent; border: none; color: var(--text-muted);
        font-size: 1rem; cursor: pointer;
    }

    .install-info { display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem; }
    .install-icon {
        width: 48px; height: 48px;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        border-radius: 14px; display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; box-shadow: 0 0 15px var(--primary-glow);
    }
    .install-text h6 { margin: 0; color: white; font-weight: 700; font-size: 0.95rem; }
    .install-text p { margin: 2px 0 0; color: var(--text-muted); font-size: 0.75rem; }

    .btn-install {
        width: 100%;
        background: var(--primary);
        border: none; color: white;
        padding: 0.625rem; border-radius: 0.75rem;
        font-weight: 700; font-size: 0.875rem;
        display: flex; align-items: center; justify-content: center; gap: 0.5rem;
        box-shadow: 0 4px 12px var(--primary-glow);
        cursor: pointer; transition: 0.2s;
    }
    .btn-install:hover { transform: translateY(-2px); box-shadow: 0 6px 15px var(--primary-glow); }

    .ios-instructions {
        background: rgba(255,255,255,0.05);
        padding: 0.75rem; border-radius: 0.75rem;
        font-size: 0.8rem; color: var(--text-secondary);
        text-align: center; border: 1px dashed var(--border);
    }

    @@keyframes slideInDown { from { transform: translateY(-100%); } to { transform: translateY(0); } }
    @@keyframes slideInUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

</style>

@code {
    private bool collapseNavMenu = true;
    private string NavMenuCssClass => collapseNavMenu ? "collapse" : "d-block";
    private string searchQuery = string.Empty;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
        {
            Nav.NavigateTo($"expenses?search={Uri.EscapeDataString(searchQuery)}");
            searchQuery = string.Empty;
            collapseNavMenu = true;
        }
    }

    private void QuickAddExpense()
    {
        Nav.NavigateTo("expenses?add=true");
    }

    private async Task Logout()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("login");
    }

    private bool showInstallBanner = false;

    protected override async Task OnInitializedAsync()
    {
        PWA.OnChange += StateHasChanged;
        await Auth.LoadFromStorageAsync();
        var path = Nav.Uri.ToLower();
        
        if (string.IsNullOrEmpty(Auth.Email) &&
            !path.Contains("login") &&
            !path.Contains("signup") &&
            !path.Contains("home") &&
            !path.Contains("forgotpassword") &&
            !path.Contains("about"))
        {
            Nav.NavigateTo("login");
        }

        // Initialize StateService if user is logged in
        if (!string.IsNullOrEmpty(Auth.UserId))
        {
            _ = State.InitializeAsync();
        }

        Nav.LocationChanged += OnLocationChanged;
        State.OnChange += StateHasChanged;

        // Monitor for global broadcasts
        _ = StartBroadcastMonitor();
    }

    private async Task StartBroadcastMonitor()
    {
        while (true)
        {
            try
            {
                var json = await JS.InvokeAsync<string>("localStorage.getItem", "lastBroadcast");
                if (!string.IsNullOrEmpty(json))
                {
                    var broadcast = JsonSerializer.Deserialize<BroadcastPayload>(json);
                    var lastSeen = await JS.InvokeAsync<string>("localStorage.getItem", "lastSeenBroadcast");
                    
                    if (broadcast != null && broadcast.id != lastSeen)
                    {
                        ToastService.ShowToast($"📢 {broadcast.title}: {broadcast.body}", "info");
                        await JS.InvokeVoidAsync("localStorage.setItem", "lastSeenBroadcast", broadcast.id);
                        
                        // Also show a real browser notification if possible
                        await JS.InvokeVoidAsync("showLocalNotification", broadcast.title, broadcast.body);
                    }
                }
            }
            catch { }
            await Task.Delay(5000); // Check every 5 seconds
        }
    }

    private class BroadcastPayload {
        public string id { get; set; } = "";
        public string title { get; set; } = "";
        public string body { get; set; } = "";
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        collapseNavMenu = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleUpdate()
    {
        await PWA.UpdateAsync();
        PWA.SetUpdateAvailable(false); // Dismiss banner local state
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        State.OnChange -= StateHasChanged;
        PWA.OnChange -= StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        
        await PWA.InitializeAsync();
        
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/push-notifications.js");
            var firebaseConfig = new
            {
                apiKey = config["Firebase:ApiKey"],
                authDomain = config["Firebase:AuthDomain"],
                projectId = config["Firebase:ProjectId"],
                storageBucket = config["Firebase:StorageBucket"],
                messagingSenderId = config["Firebase:MessagingSenderId"],
                appId = config["Firebase:AppId"]
            };
            
            if (!string.IsNullOrEmpty(firebaseConfig.messagingSenderId)) {
                await module.InvokeVoidAsync("initialize", firebaseConfig);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Push init error: " + ex.Message);
        }
    }

    private bool mobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private async Task RegisterForPush()
    {
        try
        {
            var vapidKey = config["Firebase:VapidKey"];
            if (string.IsNullOrEmpty(vapidKey)) return;

            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/push-notifications.js");
            string token = await module.InvokeAsync<string>("requestPermissionAndGetToken", vapidKey);
            
            if (!string.IsNullOrEmpty(token))
            {
                await Firebase.SaveFcmTokenAsync(token);
                PWA.SetNotificationPermission("granted");
                ToastService.ShowToast("✅ Notifications enabled! You are now subscribed.", "success");
            }
            else
            {
                ToastService.ShowToast("❌ Failed to enable notifications. Check browser permissions.", "danger");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast("Error: " + ex.Message, "danger");
        }
    }
}
