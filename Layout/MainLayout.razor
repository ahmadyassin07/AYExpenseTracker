@inherits LayoutComponentBase
@using AYExpenseTracker.Services
@using System.Text.Json
@inject FirebaseAuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject FirebaseService Firebase
@inject IConfiguration config
@inject ToastService ToastService
@inject StateService State
@inject PWAService PWA
@implements IDisposable

<div class="app-shell @(mobileMenuOpen ? "side-menu-open" : "")">
    
    @* --- MOBILE TOP NAV --- *@
    <div class="mobile-header d-md-none">
        <button class="menu-toggle" @onclick="ToggleMobileMenu" style="background:none; border:none; color:white; font-size:1.5rem;">
            <i class="bi bi-list"></i>
        </button>
        <div class="mobile-logo" style="flex:1; text-align:center; font-weight:800; font-size:1.2rem;">
            <span class="logo-icon">💰</span>
            <span class="logo-text">AY<span>Expense</span></span>
        </div>
        <div class="mobile-actions">
            <button class="action-btn" @onclick='() => Nav.NavigateTo("notifications")' style="background:none; border:none; color:white; font-size:1.2rem;">
                <i class="bi bi-bell"></i>
            </button>
        </div>
    </div>

    
    @* --- PWA UPDATE BANNER --- *@
    @* --- PWA UPDATE BANNER (Floating Notification) --- *@
    @if (PWA.IsUpdateAvailable)
    {
        <div class="pwa-update-floating animate-slide-in-right">
            <div class="floating-content">
                <div class="floating-icon">
                    <i class="bi bi-stars"></i>
                </div>
                <div class="floating-text">
                    <h6>Update Available</h6>
                    <p>A new version of AYExpense is ready.</p>
                </div>
                <button class="btn-floating-refresh" @onclick="HandleUpdate">
                    Update <i class="bi bi-arrow-right-short"></i>
                </button>
            </div>
        </div>
    }

    @* --- BOTTOM NAVIGATION (Mobile) --- *@
    <div class="bottom-nav d-md-none">
        <NavLink href="" class="bottom-nav-item" Match="NavLinkMatch.All">
            <i class="bi bi-house-door"></i>
            <span>Home</span>
        </NavLink>
        <NavLink href="expenses" class="bottom-nav-item">
            <i class="bi bi-wallet2"></i>
            <span>Activity</span>
        </NavLink>
        <div class="bottom-nav-add">
            <button class="add-btn-fab" @onclick='() => Nav.NavigateTo("expenses")'>
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
        <NavLink href="insights" class="bottom-nav-item">
            <i class="bi bi-bar-chart"></i>
            <span>Insights</span>
        </NavLink>
        <NavLink href="budget" class="bottom-nav-item">
            <i class="bi bi-bullseye"></i>
            <span>Budget</span>
        </NavLink>
    </div>

    @* --- PWA INSTALL BANNER --- *@
    @if (showInstallBanner && !PWA.IsStandalone)
    {
        @* Only show automatically if installable/iOS, otherwise show if user clicked the sidebar link *@
        @if (PWA.IsInstallable || PWA.IsiOS || (/* user must have clicked if we are here and normal checks fail */ true))
        {
            <div class="pwa-install-banner">
                <div class="install-card">
                    <button class="close-banner" @onclick="() => showInstallBanner = false">✕</button>
                    <div class="install-info">
                        <div class="install-icon">💰</div>
                        <div class="install-text">
                            <h6>Install AYExpense Tracker</h6>
                            <p>Enjoy a faster, premium experience on your home screen.</p>
                        </div>
                    </div>
                    
                    @if (PWA.IsInstallable)
                    {
                        <button class="btn-install" @onclick="() => PWA.InstallAsync()">
                            <i class="bi bi-download"></i> Install Now
                        </button>
                    }
                    else if (PWA.IsiOS)
                    {
                        <div class="ios-instructions">
                            <div>Tap <i class="bi bi-share"></i> then <strong>Add to Home Screen</strong></div>
                        </div>
                    }
                    else
                    {
                        <div class="ios-instructions">
                            <div>Use your browser menu to <strong>Install</strong> or <strong>Add to Home Screen</strong>.</div>
                        </div>
                    }
                </div>
            </div>
        }
    }


    <!-- ===== DESKTOP SIDEBAR ===== -->
    <nav class="sidebar d-none d-md-flex flex-column" aria-label="Main navigation">

        <!-- Logo -->
        <div class="sidebar-logo">
            <div class="sidebar-logo-icon">💰</div>
            <div>
                <div class="sidebar-logo-title">AYExpense</div>
                <div class="sidebar-logo-sub">Smart Finance</div>
            </div>
        </div>

        <!-- User Card -->
        @if (!string.IsNullOrEmpty(Auth?.Email))
        {
            <div class="sidebar-user">
                <div class="sidebar-user-avatar">
                    @(Auth.Email.Length > 0 ? Auth.Email[0].ToString().ToUpper() : "U")
                </div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name text-truncate" title="@Auth.Email">@Auth.Email</div>
                    <div class="sidebar-user-role">Account Holder</div>
                </div>
            </div>
        }

        <!-- Nav Links -->
        <div class="sidebar-nav">
            @if (!string.IsNullOrEmpty(Auth?.Email))
            {
                <div class="sidebar-search mb-4">
                    <div class="search-input-wrapper">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search transactions..." @bind="searchQuery" @onkeyup="HandleSearchKeyUp" />
                    </div>
                </div>
            }
            <div class="sidebar-nav-label">Main</div>

            @if (!string.IsNullOrEmpty(Auth?.Email))
            {
                <NavLink class="sidebar-link" href="expenses" Match="NavLinkMatch.All">
                    <i class="bi bi-wallet2"></i>
                    <span>Expenses & Income</span>
                </NavLink>

                <NavLink class="sidebar-link" href="categories">
                    <i class="bi bi-tags-fill"></i>
                    <span>Categories</span>
                </NavLink>

                <NavLink class="sidebar-link" href="dashboard">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </NavLink>

                <NavLink class="sidebar-link" href="reports">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Reports Center</span>
                </NavLink>

                <NavLink class="sidebar-link" href="insights">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Insights</span>
                </NavLink>

                <NavLink class="sidebar-link" href="budget">
                    <i class="bi bi-piggy-bank-fill"></i>
                    <span>Budget & Goals</span>
                </NavLink>

                <div class="sidebar-nav-label mt-3">Tools</div>

                <NavLink class="sidebar-link" href="scanreceipt">
                    <i class="bi bi-camera-fill"></i>
                    <span>Scan Receipt</span>
                </NavLink>

                <NavLink class="sidebar-link" href="about">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>About</span>
                </NavLink>

                @if (Auth?.Email?.ToLower() == "ahmadyassin07@gmail.com")
                {
                    <NavLink class="sidebar-link" href="admin-notifications">
                        <i class="bi bi-shield-lock-fill" style="color:var(--primary)"></i>
                        <span>Admin Panel</span>
                    </NavLink>
                }

                @if (!PWA.IsStandalone)
                {
                    <button class="sidebar-link w-100 text-start border-0 bg-transparent" @onclick="() => showInstallBanner = true">
                        <i class="bi bi-phone-fill" style="color:var(--accent)"></i>
                        <span>Install App</span>
                    </button>
                }
            }
            else
            {
                <NavLink class="sidebar-link" href="home" Match="NavLinkMatch.All">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Home</span>
                </NavLink>
                <NavLink class="sidebar-link" href="login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Sign In</span>
                </NavLink>
                <NavLink class="sidebar-link" href="signup">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Sign Up</span>
                </NavLink>
            }
        </div>

        <!-- Footer Actions -->
        <div class="sidebar-footer">
            @if (!string.IsNullOrEmpty(Auth?.Email))
            {
                <button class="sidebar-link w-100 text-start border-0 bg-transparent @(PWA.IsNotificationEnabled ? "" : "notification-pulse")" @onclick="RegisterForPush">
                    <i class="bi bi-bell-fill" style="color:var(--warning)"></i>
                    <span>Notifications</span>
                </button>
                <button class="sidebar-logout" @onclick="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Sign Out</span>
                </button>
            }
        </div>
    </nav>

    <!-- ===== MOBILE TOP NAV ===== -->
    <div class="mobile-topnav d-flex d-md-none">
        <div class="mobile-topnav-brand">
            <span class="mobile-logo-icon">💰</span>
            <span class="mobile-logo-text">AYExpenseTracker</span>
        </div>
        <button class="mobile-menu-btn" @onclick="ToggleNavMenu" aria-label="Toggle menu">
            <i class="bi @(collapseNavMenu ? "bi-list" : "bi-x-lg")"></i>
        </button>
    </div>

    <!-- Mobile Slide-down Menu -->
    <div class="@NavMenuCssClass mobile-menu d-md-none">
        @if (!string.IsNullOrEmpty(Auth?.Email))
        {
            <div class="mobile-user-card">
                <div class="mobile-avatar">@(Auth.Email.Length > 0 ? Auth.Email[0].ToString().ToUpper() : "U")</div>
                <div>
                    <div class="mobile-user-email text-truncate">@Auth.Email</div>
                    <div class="mobile-user-role">Account Holder</div>
                </div>
            </div>
        }

        <div class="mobile-nav-links">
            @if (!string.IsNullOrEmpty(Auth?.Email))
            {
                <div class="mobile-search mb-3 px-2">
                    <div class="search-input-wrapper">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search..." @bind="searchQuery" @onkeyup="HandleSearchKeyUp" />
                    </div>
                </div>
                <NavLink class="mobile-nav-link" href="expenses">
                    <i class="bi bi-wallet2"></i> Expenses & Income
                </NavLink>
                <NavLink class="mobile-nav-link" href="categories">
                    <i class="bi bi-tags-fill"></i> Categories
                </NavLink>
                <NavLink class="mobile-nav-link" href="dashboard">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </NavLink>
                <NavLink class="mobile-nav-link" href="reports">
                    <i class="bi bi-file-earmark-bar-graph"></i> Reports Center
                </NavLink>
                <NavLink class="mobile-nav-link" href="insights">
                    <i class="bi bi-graph-up-arrow"></i> Insights
                </NavLink>
                <NavLink class="mobile-nav-link" href="budget">
                    <i class="bi bi-piggy-bank-fill"></i> Budget & Goals
                </NavLink>
                @* Notifications moved up for visibility *@
                <button class="mobile-nav-link border-0 bg-transparent w-100 text-start notification-pulse" @onclick="RegisterForPush">
                    <i class="bi bi-bell-fill" style="color:var(--warning)"></i>
                    Notifications
                    <span class="notif-badge-active"></span>
                </button>

                <NavLink class="mobile-nav-link" href="scanreceipt">
                    <i class="bi bi-camera-fill"></i> Scan Receipt
                </NavLink>

                @if (Auth?.Email?.ToLower() == "ahmadyassin07.gmail.com" || Auth?.Email?.ToLower() == "ahmadyassin07@gmail.com")
                {
                    <NavLink class="mobile-nav-link" href="admin-notifications">
                        <i class="bi bi-shield-lock-fill" style="color:var(--primary)"></i> Admin Panel
                    </NavLink>
                }
                <button class="mobile-nav-link border-0 bg-transparent w-100 text-start" @onclick="Logout">
                    <i class="bi bi-box-arrow-right" style="color:var(--danger)"></i>
                    <span style="color:var(--danger)">Sign Out</span>
                </button>

                @if (!PWA.IsStandalone)
                {
                    <button class="mobile-nav-link border-0 bg-transparent w-100 text-start" @onclick="() => showInstallBanner = true">
                        <i class="bi bi-phone-fill" style="color:var(--accent)"></i>
                        Install App
                    </button>
                }
            }
            else
            {
                <NavLink class="mobile-nav-link" href="home">
                    <i class="bi bi-house-door-fill"></i> Home
                </NavLink>
                <NavLink class="mobile-nav-link" href="login">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </NavLink>
                <NavLink class="mobile-nav-link" href="signup">
                    <i class="bi bi-person-plus-fill"></i> Sign Up
                </NavLink>
            }
        </div>
    </div>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        @Body
        <!-- Mobile bottom spacer -->
        @if (!string.IsNullOrEmpty(Auth?.Email))
        {
            <div class="mobile-bottom-spacer"></div>
        }
    </main>

    <!-- ===== MOBILE BOTTOM NAV ===== -->
    @if (!string.IsNullOrEmpty(Auth?.Email))
    {
        <nav class="mobile-bottom-nav d-flex d-md-none" aria-label="Bottom navigation">
            <NavLink class="bottom-nav-item" href="expenses" Match="NavLinkMatch.All">
                <i class="bi bi-wallet2"></i>
                <span>Summary</span>
            </NavLink>
            <NavLink class="bottom-nav-item" href="categories">
                <i class="bi bi-tags-fill"></i>
                <span>Categories</span>
            </NavLink>
            <NavLink class="bottom-nav-item" href="dashboard">
                <i class="bi bi-speedometer2"></i>
                <span>Stats</span>
            </NavLink>
            <NavLink class="bottom-nav-item" href="reports">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <span>Reports</span>
            </NavLink>
            <NavLink class="bottom-nav-item" href="budget">
                <i class="bi bi-piggy-bank-fill"></i>
                <span>Budget</span>
            </NavLink>
        </nav>
    }

    <!-- Toast -->
    <AYExpenseTracker.Pages.Toast />

    <!-- Global Floating Action Button (FAB) -->
    @if (!string.IsNullOrEmpty(Auth?.Email))
    {
        <button class="fab-btn" @onclick="QuickAddExpense" aria-label="Quick Add Expense">
            <i class="bi bi-plus-lg"></i>
            <span class="fab-label">Add Expense</span>
        </button>
    }

</div>

<style>
    :root {
        --mobile-nav-height: 65px;
        --sidebar-width: 260px;
    }

    /* ===== APP SHELL ===== */
    .app-shell {
        display: flex;
        min-height: 100vh;
        background: var(--bg-base);
        position: relative;
    }

    /* ===== SIDEBAR ===== */
    .sidebar {
        width: var(--sidebar-width);
        background: var(--bg-surface);
        border-right: 1px solid var(--border);
        flex-shrink: 0;
        height: 100vh;
        position: sticky;
        top: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 1.25rem 0.875rem;
        gap: 0;
    }

    .sidebar::-webkit-scrollbar { width: 4px; }
    .sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

    /* Logo */
    .sidebar-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.5rem 1.25rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 1rem;
    }

    .sidebar-logo-icon {
        width: 40px; height: 40px;
        background: linear-gradient(135deg, var(--primary), #8b5cf6);
        border-radius: var(--radius-md);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
        box-shadow: 0 0 20px var(--primary-glow);
    }

    .sidebar-logo-title {
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--text-primary);
        letter-spacing: -0.02em;
        line-height: 1;
    }

    .sidebar-logo-sub {
        font-size: 0.65rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-top: 2px;
    }

    /* Floating Update Notification */
    .pwa-update-floating {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 3000;
        max-width: 320px;
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(99, 102, 241, 0.3);
        border-radius: 1.25rem;
        padding: 1rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.5), 0 0 20px rgba(99, 102, 241, 0.2);
    }
    .floating-content { display: flex; align-items: center; gap: 0.875rem; }
    .floating-icon {
        width: 40px; height: 40px;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1.25rem; flex-shrink: 0;
    }
    .floating-text h6 { margin: 0; color: white; font-weight: 700; font-size: 0.9rem; }
    .floating-text p { margin: 2px 0 0; color: rgba(255,255,255,0.6); font-size: 0.75rem; }
    .btn-floating-refresh {
        background: var(--primary);
        border: none; color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 0.75rem;
        font-size: 0.75rem; font-weight: 700;
        cursor: pointer; transition: 0.2s;
        white-space: nowrap;
    }
    .btn-floating-refresh:hover { background: var(--accent); transform: scale(1.05); }

    @@keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
    .animate-slide-in-right { animation: slideInRight 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275); }

    /* User Card */
    .sidebar-user {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.75rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 1.25rem;
        margin-bottom: 1.25rem;
        transition: 0.3s;
    }
    .sidebar-user:hover { background: rgba(255, 255, 255, 0.05); border-color: rgba(99, 102, 241, 0.2); }

    .sidebar-user-avatar {
        width: 36px; height: 36px;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.875rem;
        font-weight: 700;
        color: white;
        flex-shrink: 0;
    }

    .sidebar-user-name {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-primary);
        max-width: 150px;
    }

    .sidebar-user-role {
        font-size: 0.7rem;
        color: var(--text-muted);
    }

    /* Nav */
    .sidebar-nav { flex: 1; }

    .sidebar-nav-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--text-muted);
        padding: 0 0.5rem;
        margin-bottom: 0.5rem;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.625rem 0.75rem;
        border-radius: var(--radius-md);
        color: var(--text-secondary) !important;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: var(--transition);
        margin-bottom: 2px;
        cursor: pointer;
    }

    .sidebar-link i { font-size: 1rem; flex-shrink: 0; width: 20px; text-align: center; }

    .sidebar-link:hover {
        background: var(--bg-glass-hover);
        color: var(--text-primary) !important;
    }

    .sidebar-link.active {
        background: var(--primary-light) !important;
        color: var(--primary) !important;
        font-weight: 600;
    }

    .sidebar-link.active i { color: var(--primary); }

    /* Footer */
    .sidebar-footer {
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        margin-top: auto;
    }

    .sidebar-logout {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.625rem 0.75rem;
        border-radius: var(--radius-md);
        color: var(--danger) !important;
        background: transparent;
        border: none;
        font-size: 0.875rem;
        font-weight: 600;
        width: 100%;
        cursor: pointer;
        transition: var(--transition);
        margin-top: 4px;
    }

    .sidebar-logout:hover { background: var(--danger-light); }
    .sidebar-logout i { font-size: 1rem; }

    /* ===== MOBILE TOP NAV ===== */
    .mobile-topnav {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 56px;
        background: rgba(10, 15, 30, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--border);
        align-items: center;
        justify-content: space-between;
        padding: 0 1rem;
        z-index: 1000;
    }

    .mobile-topnav-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .mobile-logo-icon { font-size: 1.25rem; }

    .mobile-logo-text {
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--text-primary);
        letter-spacing: -0.02em;
    }

    .mobile-menu-btn {
        width: 36px; height: 36px;
        background: var(--bg-glass);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        display: flex; align-items: center; justify-content: center;
        color: var(--text-primary);
        font-size: 1.1rem;
        cursor: pointer;
        transition: var(--transition);
    }

    .mobile-menu-btn:hover { background: var(--bg-glass-hover); }

    /* Mobile Slide Menu */
    .mobile-menu {
        position: fixed;
        top: 56px; left: 0; right: 0;
        background: rgba(10, 15, 30, 0.98);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--border);
        z-index: 999;
        padding: 1rem;
        animation: slideDown 0.3s ease;
    }

    .mobile-menu.collapse { display: none !important; }

    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .mobile-user-card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: var(--bg-glass);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        margin-bottom: 1rem;
    }

    .mobile-avatar {
        width: 36px; height: 36px;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; color: white; font-size: 0.875rem;
        flex-shrink: 0;
    }

    .mobile-user-email { font-size: 0.8rem; font-weight: 600; color: var(--text-primary); max-width: 200px; }
    .mobile-user-role { font-size: 0.7rem; color: var(--text-muted); }

    .mobile-nav-links { display: flex; flex-direction: column; gap: 2px; }

    .mobile-nav-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        border-radius: var(--radius-md);
        color: var(--text-secondary) !important;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: var(--transition);
        cursor: pointer;
    }

    .mobile-nav-link:hover, .mobile-nav-link.active {
        background: var(--primary-light);
        color: var(--primary) !important;
    }

    .mobile-nav-link i { font-size: 1.1rem; width: 22px; text-align: center; }

    /* ===== MAIN CONTENT ===== */
    .main-content {
        flex: 1;
        min-width: 0;
        overflow-x: hidden;
        padding-top: 0;
        background: var(--bg-base);
    }

